<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <PackageId>NetReact.DevRunner</PackageId>
    <ToolCommandName>netreact</ToolCommandName>
    <Version>0.5.0</Version>
    <Authors>Tanish Gupta</Authors>
    <Description>Run ASP.NET Core and React development services from one terminal.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Tanish15-gif/netreact-devrunner</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-tool;net11.0;aspnetcore;react;vite;cli;process-supervision;hot-reload</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetReact.DevRunner.Tests" />
    <None Include="../../docs/netreact-devrunner.png" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/screenshots/*.png" Pack="true" PackagePath="docs/screenshots/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../devrunner.example.yaml" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CONTRIBUTING.md;../../CODE_OF_CONDUCT.md;../../SECURITY.md" Pack="true" PackagePath="/" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetReact.DevRunner.Infrastructure\NetReact.DevRunner.Infrastructure.csproj" />
  </ItemGroup>

</Project>
